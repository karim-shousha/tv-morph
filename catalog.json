    {
      "id": "phone",
      "name": "Android Phone",
      "available": true,
      "version": "0.8.21",
      "download": "/download/phone",
      "noteAr": "تطبيق الموبايل لإدارة التصميم والربط واختيار بروفايلات العيلة. Android 8 أو أحدث. ثيمات رياضية جاهزة بصور PNG وتحسين اللغات الخمس. مواقيت الصلاة بألوان الثيم وأذان مصر ومكة أثناء ظهور TV Morph.",
      "noteEn": "Phone companion for design, pairing and family profile selection. Android 8 or later. Ready sports themes with built-in PNG artwork and improved five-language mobile UI. Themed prayer dashboard with Egyptian/Makkah Adhan while TV Morph is visible."
    },
    {
      "id": "android",
      "name": "Android TV / Google TV",
      "available": true,
      "version": "0.8.21",
      "download": "/download/android",
      "noteAr": "Android 8 أو أحدث. بروفايلات عائلية وبحث IPTV موحّد ودليل برامج EPG عند دعم المزوّد. التثبيت يحتاج موافقة التلفزيون. ثيمات رياضية جاهزة بصور PNG وتحسين اللغات الخمس. مواقيت الصلاة بألوان الثيم وأذان مصر ومكة أثناء ظهور TV Morph.",
      "noteEn": "Android 8+. Family profiles, unified IPTV title search and provider-supported EPG. Installation needs TV confirmation. Ready sports themes with built-in PNG artwork and improved five-language mobile UI. Themed prayer dashboard with Egyptian/Makkah Adhan while TV Morph is visible."
    },
    {
      "id": "firetv",
      "name": "Amazon Fire TV · Fire OS",
      "available": true,
      "version": "0.8.21",
      "download": "/download/firetv",
      "noteAr": "Fire OS المبني على Android 8+، وليس Vega OS. بروفايلات عائلية وبحث IPTV موحّد وEPG حسب المزوّد. إرسال ADB يحتاج موافقة الشاشة. ثيمات رياضية جاهزة بصور PNG وتحسين اللغات الخمس. مواقيت الصلاة بألوان الثيم وأذان مصر ومكة أثناء ظهور TV Morph.",
      "noteEn": "Android 8+ based Fire OS, not Vega OS. Family profiles, unified IPTV search and provider-supported EPG. ADB delivery requires TV approval. Ready sports themes with built-in PNG artwork and improved five-language mobile UI. Themed prayer dashboard with Egyptian/Makkah Adhan while TV Morph is visible."
    },
    {
      "id": "samsung",
      "name": "Samsung · Tizen",
      "available": false,
      "noteAr": "التثبيت التجريبي من تطبيق الموبايل يحتاج Developer Mode وشهادة لجهازك. لا يوجد ملف عام صالح لكل أجهزة Samsung.",
      "noteEn": "Experimental installation from the phone requires Developer Mode and a per-device certificate. No universal Samsung download.",
