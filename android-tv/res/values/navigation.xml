<resources>
    <style name="MorphInstantAnimations">
        <item name="android:activityOpenEnterAnimation">@null</item><item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item><item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item><item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item><item name="android:taskCloseExitAnimation">@null</item>
    </style>
    <style name="MorphInstantTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowAnimationStyle">@style/MorphInstantAnimations</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">#07101e</item>
    </style>
    <style name="MorphRadioTheme" parent="MorphInstantTheme">
        <item name="android:windowBackground">@drawable/bridge_entry_background</item>
    </style>
</resources>
